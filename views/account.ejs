<section class="page-header">
  <div class="container">
    <h1>My Account</h1>
  </div>
</section>

<section class="container section account-grid">
  <div class="account-form-wrap">
    <h2>Profile Details</h2>
    <% if (errors && errors.length) { %>
      <div class="alert alert-error">
        <ul><% errors.forEach(function(e) { %><li><%= e.msg %></li><% }) %></ul>
      </div>
    <% } %>
    <form action="/account" method="POST" class="form">
      <div class="form-row">
        <label>Full Name</label>
        <input type="text" name="name" value="<%= user.name %>" required />
      </div>
      <div class="form-row">
        <label>Email</label>
        <input type="email" value="<%= user.email %>" disabled />
      </div>
      <div class="form-row">
        <label>Phone</label>
        <input type="text" name="phone" value="<%= user.phone || '' %>" />
      </div>

      <h3>Default Shipping Address</h3>
      <div class="form-row">
        <label>Full Name (for delivery)</label>
        <input type="text" name="fullName" value="<%= (user.address && user.address.fullName) || '' %>" />
      </div>
      <div class="form-row">
        <label>Delivery Phone</label>
        <input type="text" name="addrPhone" value="<%= (user.address && user.address.phone) || '' %>" />
      </div>
      <div class="form-row">
        <label>Address Line</label>
        <input type="text" name="line1" value="<%= (user.address && user.address.line1) || '' %>" />
      </div>
      <div class="form-row two-col">
        <div>
          <label>City</label>
          <input type="text" name="city" value="<%= (user.address && user.address.city) || '' %>" />
        </div>
        <div>
          <label>Postal Code</label>
          <input type="text" name="postalCode" value="<%= (user.address && user.address.postalCode) || '' %>" />
        </div>
      </div>
      <button type="submit" class="btn btn-primary">Save Changes</button>
    </form>
  </div>

  <div class="account-orders-wrap">
    <div class="section-head">
      <h2>Recent Orders</h2>
      <a href="/orders" class="section-link">View all &rarr;</a>
    </div>
    <% if (recentOrders && recentOrders.length) { %>
      <table class="data-table">
        <thead><tr><th>Order #</th><th>Date</th><th>Total</th><th>Status</th></tr></thead>
        <tbody>
          <% recentOrders.forEach(function(o) { %>
            <tr>
              <td><a href="/orders/<%= o._id %>"><%= o.orderNumber %></a></td>
              <td><%= o.createdAt.toDateString() %></td>
              <td><%= currencySymbol %><%= o.grandTotal.toFixed(0) %></td>
              <td><span class="status-pill status-<%= o.status %>"><%= o.status %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <p class="empty-note">You haven't placed any orders yet. <a href="/products">Start shopping →</a></p>
    <% } %>
  </div>
</section>
