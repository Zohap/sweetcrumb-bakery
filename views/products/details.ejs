<section class="container section product-details">
  <nav class="breadcrumbs">
    <a href="/">Home</a> / <a href="/products">Products</a> /
    <% if (product.category) { %><a href="/products?category=<%= product.category.slug %>"><%= product.category.name %></a> / <% } %>
    <span><%= product.name %></span>
  </nav>

  <div class="product-details-grid">
    <div class="product-details-img">
      <img src="<%= product.image %>" alt="<%= product.name %>" />
      <% if (product.discountPercent > 0) { %><span class="badge badge-sale">-<%= product.discountPercent %>%</span><% } %>
    </div>

    <div class="product-details-info">
      <p class="product-card-category"><%= product.category ? product.category.name : '' %></p>
      <h1><%= product.name %></h1>
      <div class="product-card-rating">
        <% for (let i = 1; i <= 5; i++) { %><span class="star <%= i <= Math.round(product.ratingAverage) ? 'filled' : '' %>">★</span><% } %>
        <span class="rating-count"><%= product.ratingAverage.toFixed(1) %> (<%= product.ratingCount %> review<%= product.ratingCount === 1 ? '' : 's' %>)</span>
      </div>

      <div class="product-details-price">
        <% if (product.discountPrice > 0 && product.discountPrice < product.price) { %>
          <span class="price-old"><%= currencySymbol %><%= product.price.toFixed(0) %></span>
          <span class="price-now big"><%= currencySymbol %><%= product.discountPrice.toFixed(0) %></span>
        <% } else { %>
          <span class="price-now big"><%= currencySymbol %><%= product.price.toFixed(0) %></span>
        <% } %>
      </div>

      <p class="product-details-desc"><%= product.description %></p>

      <ul class="product-meta-list">
        <% if (product.weightGrams) { %><li><strong>Weight:</strong> <%= product.weightGrams %>g</li><% } %>
        <% if (product.sku) { %><li><strong>SKU:</strong> <%= product.sku %></li><% } %>
        <li><strong>Availability:</strong>
          <% if (product.stock > 5) { %><span class="in-stock">In Stock</span>
          <% } else if (product.stock > 0) { %><span class="low-stock">Only <%= product.stock %> left!</span>
          <% } else { %><span class="out-stock">Out of Stock</span><% } %>
        </li>
      </ul>

      <% if (product.ingredients) { %>
        <div class="ingredients-box">
          <strong>Ingredients:</strong> <%= product.ingredients %>
        </div>
      <% } %>

      <form action="/cart/add" method="POST" class="add-to-cart-form">
        <input type="hidden" name="productId" value="<%= product._id %>" />
        <input type="hidden" name="redirectTo" value="/products/<%= product.slug %>" />
        <label for="qty">Quantity</label>
        <input type="number" id="qty" name="quantity" value="1" min="1" max="<%= Math.max(product.stock, 1) %>" <%= product.stock < 1 ? 'disabled' : '' %> />
        <button type="submit" class="btn btn-primary btn-lg" <%= product.stock < 1 ? 'disabled' : '' %>>
          <%= product.stock < 1 ? 'Out of Stock' : 'Add to Cart' %>
        </button>
      </form>
    </div>
  </div>

  <div class="reviews-section">
    <h2>Customer Reviews (<%= reviews.length %>)</h2>

    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <form action="/products/<%= product.slug %>/reviews" method="POST" class="review-form form">
        <h3><%= myReview ? 'Update your review' : 'Write a review' %></h3>
        <div class="form-row">
          <label>Rating</label>
          <select name="rating">
            <% for (let i = 5; i >= 1; i--) { %>
              <option value="<%= i %>" <%= myReview && myReview.rating === i ? 'selected' : '' %>><%= i %> Star<%= i === 1 ? '' : 's' %></option>
            <% } %>
          </select>
        </div>
        <div class="form-row">
          <label>Comment</label>
          <textarea name="comment" rows="3"><%= myReview ? myReview.comment : '' %></textarea>
        </div>
        <button type="submit" class="btn btn-outline">Submit Review</button>
      </form>
    <% } else { %>
      <p class="empty-note"><a href="/login">Log in</a> to write a review.</p>
    <% } %>

    <% if (reviews.length) { %>
      <div class="review-list">
        <% reviews.forEach(function(r) { %>
          <div class="review-item">
            <div class="review-item-head">
              <strong><%= r.userName %></strong>
              <span class="product-card-rating">
                <% for (let i = 1; i <= 5; i++) { %><span class="star <%= i <= r.rating ? 'filled' : '' %>">★</span><% } %>
              </span>
              <span class="review-date"><%= r.createdAt.toDateString() %></span>
            </div>
            <% if (r.comment) { %><p><%= r.comment %></p><% } %>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p class="empty-note">No reviews yet. Be the first to review this product!</p>
    <% } %>
  </div>

  <% if (related && related.length) { %>
    <div class="section-head">
      <h2>You Might Also Like</h2>
    </div>
    <div class="product-grid">
      <% related.forEach(function(p) { %>
        <%- include('../partials/product-card', { product: p }) %>
      <% }) %>
    </div>
  <% } %>
</section>
