<section class="page-header">
  <div class="container">
    <h1>Our Products</h1>
    <p><%= total %> item<%= total === 1 ? '' : 's' %> found<% if (query.q) { %> for "<%= query.q %>"<% } %></p>
  </div>
</section>

<section class="container section products-layout">
  <aside class="filters-panel">
    <form action="/products" method="GET" class="form">
      <% if (query.q) { %><input type="hidden" name="q" value="<%= query.q %>" /><% } %>

      <h3>Category</h3>
      <ul class="filter-list">
        <li><a href="/products<%= query.q ? '?q=' + query.q : '' %>" class="<%= !query.category ? 'active' : '' %>">All Categories</a></li>
        <% categories.forEach(function(cat) { %>
          <li>
            <a href="/products?category=<%= cat.slug %><%= query.q ? '&q=' + query.q : '' %>" class="<%= query.category === cat.slug ? 'active' : '' %>">
              <%= cat.name %>
            </a>
          </li>
        <% }) %>
      </ul>

      <h3>Price Range</h3>
      <div class="form-row two-col">
        <div>
          <label>Min</label>
          <input type="number" name="minPrice" value="<%= query.minPrice || '' %>" min="0" step="0.5" />
        </div>
        <div>
          <label>Max</label>
          <input type="number" name="maxPrice" value="<%= query.maxPrice || '' %>" min="0" step="0.5" />
        </div>
      </div>
      <% if (query.category) { %><input type="hidden" name="category" value="<%= query.category %>" /><% } %>
      <button type="submit" class="btn btn-outline btn-block">Apply Filters</button>
    </form>
  </aside>

  <div class="products-main">
    <div class="products-toolbar">
      <form action="/products" method="GET" class="sort-form">
        <% if (query.q) { %><input type="hidden" name="q" value="<%= query.q %>" /><% } %>
        <% if (query.category) { %><input type="hidden" name="category" value="<%= query.category %>" /><% } %>
        <label>Sort by</label>
        <select name="sort" onchange="this.form.submit()">
          <option value="newest" <%= (!query.sort || query.sort === 'newest') ? 'selected' : '' %>>Newest</option>
          <option value="price_asc" <%= query.sort === 'price_asc' ? 'selected' : '' %>>Price: Low to High</option>
          <option value="price_desc" <%= query.sort === 'price_desc' ? 'selected' : '' %>>Price: High to Low</option>
          <option value="name_asc" <%= query.sort === 'name_asc' ? 'selected' : '' %>>Name: A-Z</option>
          <option value="rating" <%= query.sort === 'rating' ? 'selected' : '' %>>Top Rated</option>
        </select>
      </form>
    </div>

    <% if (products.length) { %>
      <div class="product-grid">
        <% products.forEach(function(product) { %>
          <%- include('../partials/product-card', { product: product }) %>
        <% }) %>
      </div>

      <% if (totalPages > 1) { %>
        <div class="pagination">
          <% for (let p = 1; p <= totalPages; p++) { %>
            <a href="/products?page=<%= p %><%= query.q ? '&q=' + query.q : '' %><%= query.category ? '&category=' + query.category : '' %><%= query.sort ? '&sort=' + query.sort : '' %>"
               class="<%= p === page ? 'active' : '' %>"><%= p %></a>
          <% } %>
        </div>
      <% } %>
    <% } else { %>
      <p class="empty-note">No products matched your search. Try a different filter.</p>
    <% } %>
  </div>
</section>
