<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Login | Sweet Crumb Bakery</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body class="admin-login-body">
  <div class="admin-login-card">
    <div class="admin-brand center">🥐 <span>Sweet Crumb</span><small>Admin Panel</small></div>

    <% if (errors && errors.length) { %>
      <div class="alert alert-error">
        <ul><% errors.forEach(function(e) { %><li><%= e.msg %></li><% }) %></ul>
      </div>
    <% } %>

    <form action="/admin/login" method="POST" class="form">
      <div class="form-row">
        <label>Admin Email</label>
        <input type="email" name="email" value="<%= email || '' %>" required autofocus />
      </div>
      <div class="form-row">
        <label>Password</label>
        <input type="password" name="password" required />
      </div>
      <button type="submit" class="btn btn-primary btn-block">Log In to Admin Panel</button>
    </form>
    <p class="admin-login-note"><a href="/">&larr; Back to store</a></p>
  </div>
</body>
</html>
