<div class="admin-toolbar">
  <span></span>
  <a href="/admin/categories/new" class="btn btn-primary">+ Add Category</a>
</div>

<% if (categories.length) { %>
  <table class="data-table">
    <thead><tr><th>Image</th><th>Name</th><th>Products</th><th>Status</th><th>Actions</th></tr></thead>
   <tbody>
  <% categories.forEach(function(cat) { %>
    <tr>

      <td data-label="Image">
        <img src="<%= cat.image || '/images/placeholder-category.svg' %>" alt="<%= cat.name %>" class="admin-thumb" />
      </td>

      <td data-label="Name">
        <%= cat.name %>
      </td>

      <td data-label="Products">
        <%= countMap[cat._id] || 0 %>
      </td>

      <td data-label="Status">
        <span class="status-pill <%= cat.isActive ? 'status-delivered' : 'status-cancelled' %>">
          <%= cat.isActive ? 'Active' : 'Hidden' %>
        </span>
      </td>

      <td data-label="Actions" class="admin-actions">
        <a href="/admin/categories/<%= cat._id %>/edit" class="btn btn-outline btn-sm">Edit</a>

        <form action="/admin/categories/<%= cat._id %>/delete" method="POST" onsubmit="return confirm('Delete this category?');">
          <button type="submit" class="btn btn-danger btn-sm">Delete</button>
        </form>
      </td>

    </tr>
  <% }) %>
</tbody>
  </table>
<% } else { %>
  <p class="empty-note">No categories yet. <a href="/admin/categories/new">Add your first category</a>.</p>
<% } %>
