<section class="page-header">
  <div class="container">
    <h1>Your Cart</h1>
  </div>
</section>

<section class="container section">
  <% if (lines.length) { %>
    <div class="cart-layout">
      <div class="cart-items">
        <table class="data-table cart-table">
          <thead>
            <tr><th>Product</th><th>Price</th><th>Quantity</th><th>Total</th><th></th></tr>
          </thead>
          <tbody>
            <% lines.forEach(function(line) { %>
              <tr>
                <td class="cart-product-cell">
                  <img src="<%= line.product.image %>" alt="<%= line.product.name %>" />
                  <div>
                    <a href="/products/<%= line.product.slug %>"><%= line.product.name %></a>
                  </div>
                </td>
                <td><%= currencySymbol %><%= line.unitPrice.toFixed(0) %></td>
                <td>
                  <form action="/cart/update" method="POST" class="qty-form">
                    <input type="hidden" name="productId" value="<%= line.product._id %>" />
                    <input type="number" name="quantity" value="<%= line.quantity %>" min="0" max="<%= line.product.stock %>" onchange="this.form.submit()" />
                  </form>
                </td>
                <td><%= currencySymbol %><%= line.lineTotal.toFixed(0) %></td>
                <td>
                  <form action="/cart/remove" method="POST">
                    <input type="hidden" name="productId" value="<%= line.product._id %>" />
                    <button type="submit" class="link-button danger">Remove</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <form action="/cart/clear" method="POST">
          <button type="submit" class="link-button">Clear Cart</button>
        </form>
      </div>

      <aside class="cart-summary">
        <h3>Order Summary</h3>
        <div class="summary-row"><span>Items (<%= itemCount %>)</span><span><%= currencySymbol %><%= itemsTotal.toFixed(0) %></span></div>
        <div class="summary-row"><span>Shipping</span><span><%= itemsTotal >= 3000 ? 'FREE' : currencySymbol + '200' %></span></div>
<div class="summary-row total"><span>Total</span><span><%= currencySymbol %><%= (itemsTotal >= 3000 ? itemsTotal : itemsTotal + 200).toFixed(0) %></span></div>
        <a href="/checkout" class="btn btn-primary btn-block">Proceed to Checkout</a>
        <a href="/products" class="btn btn-outline btn-block">Continue Shopping</a>
      </aside>
    </div>
  <% } else { %>
    <div class="empty-cart">
      <span>🛒</span>
      <h2>Your cart is empty</h2>
      <p>Looks like you haven't added anything yet.</p>
      <a href="/products" class="btn btn-primary">Browse Products</a>
    </div>
  <% } %>
</section>
