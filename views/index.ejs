<section class="hero">
  <div class="container hero-inner">
    <div class="hero-text">
      <span class="eyebrow">Baked Fresh, Every Single Day</span>
      <h1>Warm bread, sweet cakes, and a whole lot of crumbs.</h1>
      <p>Sweet Crumb is a small artisan bakery bringing handcrafted breads, cakes, and pastries to your doorstep — made with real butter, real sugar, and zero shortcuts.</p>
      <div class="hero-actions">
        <a href="/products" class="btn btn-primary btn-lg">Shop All Treats</a>
        <a href="/about" class="btn btn-outline btn-lg">Our Story</a>
      </div>
    </div>
    <div class="hero-art" aria-hidden="true">🍰🥖🧁🍞🥐</div>
  </div>
</section>

<% if (categories && categories.length) { %>
<section class="container section">
  <div class="section-head">
    <h2>Shop by Category</h2>
  </div>
  <div class="category-grid">
    <% categories.forEach(function(cat) { %>
      <a href="/products?category=<%= cat.slug %>" class="category-card">
        <img src="<%= cat.image || '/images/placeholder-category.svg' %>" alt="<%= cat.name %>" />
        <span><%= cat.name %></span>
      </a>
    <% }) %>
  </div>
</section>
<% } %>

<% if (featured && featured.length) { %>
<section class="container section">
  <div class="section-head">
    <h2>Featured Favourites</h2>
    <a href="/products" class="section-link">View all &rarr;</a>
  </div>
  <div class="product-grid">
    <% featured.forEach(function(product) { %>
      <%- include('partials/product-card', { product: product }) %>
    <% }) %>
  </div>
</section>
<% } %>

<section class="promo-strip">
  <div class="container promo-grid">
    <div class="promo-item">
      <span>🚚</span>
     <div><strong>Free Delivery</strong><p>On orders over <%= currencySymbol %>3000</p></div>
    </div>
    <div class="promo-item">
      <span>🌾</span>
      <div><strong>Fresh Ingredients</strong><p>Sourced daily from local farms</p></div>
    </div>
    <div class="promo-item">
      <span>💳</span>
      <div><strong>Easy Checkout</strong><p>Cash on delivery or card</p></div>
    </div>
    <div class="promo-item">
      <span>⭐</span>
      <div><strong>Loved by Customers</strong><p>Rated 4.8/5 by regulars</p></div>
    </div>
  </div>
</section>

<% if (newest && newest.length) { %>
<section class="container section">
  <div class="section-head">
    <h2>Fresh Out of the Oven</h2>
    <a href="/products?sort=newest" class="section-link">View all &rarr;</a>
  </div>
  <div class="product-grid">
    <% newest.forEach(function(product) { %>
      <%- include('partials/product-card', { product: product }) %>
    <% }) %>
  </div>
</section>
<% } %>

<section class="newsletter">
  <div class="container newsletter-inner">
    <h2>Get 10% off your first order</h2>
    <p>Have a question, a custom cake request, or just want to say hi? <a href="/contact">Contact us</a> and we'll get back to you.</p>
  </div>
</section>
