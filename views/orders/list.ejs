<section class="page-header">
  <div class="container">
    <h1>My Orders</h1>
  </div>
</section>

<section class="container section">
  <% if (orders.length) { %>
    <table class="data-table">
      <thead><tr><th>Order #</th><th>Date</th><th>Items</th><th>Total</th><th>Status</th><th></th></tr></thead>
      <tbody>
        <% orders.forEach(function(o) { %>
          <tr>
            <td><%= o.orderNumber %></td>
            <td><%= o.createdAt.toDateString() %></td>
            <td><%= o.items.reduce(function(s, i) { return s + i.quantity; }, 0) %></td>
            <td><%= currencySymbol %><%= o.grandTotal.toFixed(0) %></td>
            <td><span class="status-pill status-<%= o.status %>"><%= o.status %></span></td>
            <td><a href="/orders/<%= o._id %>" class="btn btn-outline btn-sm">View</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <div class="empty-cart">
      <span>📦</span>
      <h2>No orders yet</h2>
      <p>When you place an order, it'll show up here.</p>
      <a href="/products" class="btn btn-primary">Start Shopping</a>
    </div>
  <% } %>
</section>
