<section class="page-header">
  <div class="container">
    <h1>Order <%= order.orderNumber %></h1>
    <p>Placed on <%= order.createdAt.toDateString() %></p>
  </div>
</section>

<section class="container section">
  <% if (justPlaced) { %>
    <div class="alert alert-success">🎉 Thank you! Your order has been placed successfully.</div>
  <% } %>

  <div class="order-details-grid">
    <div class="order-items-wrap">
      <h3>Items</h3>
      <table class="data-table">
        <thead><tr><th>Product</th><th>Price</th><th>Qty</th><th>Total</th></tr></thead>
        <tbody>
          <% order.items.forEach(function(item) { %>
            <tr>
              <td class="cart-product-cell">
                <img src="<%= item.image %>" alt="<%= item.name %>" />
                <span><%= item.name %></span>
              </td>
              <td><%= currencySymbol %><%= item.price.toFixed(0) %></td>
              <td><%= item.quantity %></td>
              <td><%= currencySymbol %><%= (item.price * item.quantity).toFixed(0) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <% if (order.status === 'pending') { %>
        <form action="/orders/<%= order._id %>/cancel" method="POST" onsubmit="return confirm('Cancel this order?');">
          <button type="submit" class="btn btn-outline">Cancel Order</button>
        </form>
      <% } %>
    </div>

    <aside class="cart-summary">
      <h3>Order Status</h3>
      <p><span class="status-pill status-<%= order.status %>"><%= order.status %></span></p>

      <h3>Shipping To</h3>
      <p>
        <%= order.shipping.fullName %><br />
        <%= order.shipping.phone %><br />
        <%= order.shipping.line1 %>, <%= order.shipping.city %>
        <% if (order.shipping.postalCode) { %> <%= order.shipping.postalCode %><% } %>
      </p>

      <h3>Payment</h3>
      <p><%= order.paymentMethod === 'cod' ? 'Cash on Delivery' : 'Card' %></p>

      <div class="summary-row"><span>Subtotal</span><span><%= currencySymbol %><%= order.itemsTotal.toFixed(0) %></span></div>
      <div class="summary-row"><span>Shipping</span><span><%= order.shippingFee === 0 ? 'FREE' : currencySymbol + order.shippingFee.toFixed(0) %></span></div>
      <div class="summary-row total"><span>Total</span><span><%= currencySymbol %><%= order.grandTotal.toFixed(0) %></span></div>

      <% if (order.notes) { %>
        <h3>Notes</h3>
        <p><%= order.notes %></p>
      <% } %>
    </aside>
  </div>
</section>
